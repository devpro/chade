{
  "name": "chade",
  "version": "0.1.0",
  "description": "Snapshot the configuration of a system, files, installed applications, extensions, services and repositories, into a git repository, one folder per machine",
  "type": "module",
  "license": "MIT",
  "bin": {
    "chade": "bin/chade.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "configuration",
    "snapshot",
    "dotfiles",
    "inventory",
    "wsl",
    "winget",
    "git"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devpro/chade.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "dev": "tsx src/bin.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json --noEmit && esbuild src/bin.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/bin.js --external:commander --external:yaml",
    "prepack": "npm run build",
    "start": "node bin/chade.js",
    "test": "../../scripts/with_test_tmpdir.sh node --import tsx --test --test-reporter=dot test/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "smoke": "./smoke.sh"
  },
  "dependencies": {
    "commander": "15.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "author": "Bertrand THOMAS",
  "bugs": {
    "url": "https://github.com/devpro/chade/issues"
  },
  "homepage": "https://github.com/devpro/chade#readme"
}
